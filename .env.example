


# Copy to .env (git-ignored) and fill in. Process env vars override these.

# Discord
BOT_TOKEN=your-bot-token
# DEV_GUILD_ID=123456789012345678

# PostgreSQL — guild config source of truth (Neon). Paste the full connection string.
# Accepts a Neon/libpq URI (postgresql://user:pass@host/db?sslmode=require) with the
# credentials embedded, OR a jdbc:postgresql://... URL. No need to split user/password out.
POSTGRES_URL=postgresql://user:password@ep-xxxx-xxxx.us-east-2.aws.neon.tech/basebot?sslmode=require
# Optional — only if your URL above has no embedded credentials (override the connection string):
# POSTGRES_USER=basebot
# POSTGRES_PASSWORD=change-me

# SQLite — local fast state
SQLITE_PATH=data/basebot.db

# Ticket transcript ingest -> davimf.dev
TICKET_INGEST_URL=https://davimf.dev/api/ticket-store
TICKET_INGEST_SECRET=change-me
TICKET_VIEW_BASE=https://davimf.dev/ticket

# Snapshots do dashboard (1 bot por cliente). Opcional: se BOT_INSTANCE_ID ficar vazio,
# o próprio bot gera e persiste um id estável no 1º boot (SQLite local_meta). Preencha
# apenas para forçar/migrar um id específico. BOT_CLIENT_NAME é rótulo opcional.
BOT_INSTANCE_ID=
BOT_CLIENT_NAME=
